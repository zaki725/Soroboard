# Enforce consistent line endings across OSes.
# Store text files as LF in the repo; let Git convert on checkout if needed.
* text=auto eol=lf

# Common source/config formats
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.sh   text eol=lf
*.ps1  text eol=lf
*.bat  text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.env  text eol=lf
*.example text eol=lf

# Treat binary assets as binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
